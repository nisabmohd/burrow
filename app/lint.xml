<?xml version="1.0" encoding="utf-8"?>
<!--
  Lint settings. Everything else is left at its default: fix the warning, don't hide it here.
-->
<lint>
    <!-- The full Phosphor set lives in res/drawable on purpose (docs/ICONS.md); release builds
         shrink away the icons the app doesn't use, so they cost nothing in the APK. -->
    <issue id="UnusedResources">
        <ignore regexp="R\.drawable\.ic_" />
    </issue>
    <!-- The adaptive launcher icon stays in mipmap-anydpi-v26: without "-v26" the release build
         can't find @mipmap/ic_launcher (AAPT), even with minSdk 26. -->
    <issue id="ObsoleteSdkInt">
        <ignore path="src/main/res/mipmap-anydpi-v26" />
    </issue>
</lint>
