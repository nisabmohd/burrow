<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash: the logo on the page colour, then straight into Compose (no second splash). -->
    <style name="Theme.Burrow" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <!-- Transparent bars for edge-to-edge on Android 8–14 (see ui/EdgeToEdge.kt). Android 15+
             ignores these and is always edge-to-edge. A theme attribute is not the deprecated call. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
