<?xml version="1.0" encoding="utf-8"?>
<!-- "Ignore" in the capture notification: a text button, ripple only. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/notification_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
