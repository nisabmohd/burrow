<?xml version="1.0" encoding="utf-8"?>
<!--
  Burrow never sends data anywhere: there is NO INTERNET permission. The tools:node="remove" lines below strip it
  even if a library tries to merge it in; still check the merged manifest after adding any dependency.
  One exception (user, 2026-10-24): the github build puts INTERNET back only to check GitHub Releases
  for updates (src/github/AndroidManifest.xml, data/update/UpdateManager.kt).
  SMS permissions live in the foss/github flavor manifests; Play adds them only after approval.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Belt and braces: strip these if any library tries to add them. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- The payment apps Auto-capture reads (PaymentNotificationListener.PAYMENT_APPS), to show their names. -->
    <queries>
        <package android:name="com.google.android.apps.nbu.paisa.user" />
        <package android:name="com.phonepe.app" />
        <package android:name="net.one97.paytm" />
        <package android:name="in.org.npci.upiapp" />
        <package android:name="com.dreamplug.androidapp" />
        <package android:name="com.snapwork.hdfc" />
        <package android:name="com.csam.icici.bank.imobile" />
        <package android:name="com.sbi.lotusintouch" />
        <package android:name="com.msf.kbank.mobile" />
        <package android:name="com.axis.mobile" />
    </queries>

    <application
        android:name=".BurrowApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Burrow">

        <!-- Lets the camera app write one photo for "Take a photo" (76). Not exported. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home-screen widgets (02): safe to spend today, add expense, next bill. RemoteViews, no library. -->
        <receiver android:name=".home.SafeToSpendWidget" android:exported="false" android:label="@string/safe_to_spend_today">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_safe_info" />
        </receiver>
        <receiver android:name=".home.AddExpenseWidget" android:exported="false" android:label="@string/add_expense">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_add_info" />
        </receiver>
        <receiver android:name=".home.NextBillWidget" android:exported="false" android:label="@string/next_bill">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_bill_info" />
        </receiver>

        <!-- Quick settings tile (03): Add expense. -->
        <service
            android:name=".home.AddExpenseTile"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/add_expense"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="false" />
        </service>

        <!-- Sunday review (13): Sunday 6 PM, one inexact alarm. -->
        <receiver android:name=".notify.WeeklyReviewReceiver" android:exported="false" />

        <!-- The capture notification's buttons (save with a category / Ignore). -->
        <receiver android:name=".capture.CaptureActionReceiver" android:exported="false" />

        <!-- Bill reminders: one inexact alarm, set again after a reboot, update or clock change. -->
        <receiver android:name=".notify.BillAlarmReceiver" android:exported="false" />
        <!-- Scheduled backups: a daily check around 3 AM. -->
        <receiver android:name=".data.BackupAlarmReceiver" android:exported="false" />
        <receiver android:name=".notify.RescheduleReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Payment-app notifications (GPay, PhonePe…). The user grants access in system settings. -->
        <service
            android:name=".capture.PaymentNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
